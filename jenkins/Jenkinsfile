pipeline {
  agent any

  environment {
    REGISTRY = 'docker.io'
    IMAGE_BACKEND = 'intelligent-devops-platform-backend'
    IMAGE_FRONTEND = 'intelligent-devops-platform-frontend'

    DOCKERHUB_CREDENTIALS_ID = 'dockerhub-credentials'
    GITHUB_CREDENTIALS_ID = 'github-token'
    SLACK_WEBHOOK_CREDENTIALS_ID = 'slack-webhook'
    SONARQUBE_TOKEN_CREDENTIALS_ID = 'sonarqube-token'
    NVD_API_KEY_CREDENTIALS_ID = 'nvd-api-key'

    VERSION_FILE = 'helm/intelligent-platform/values.yaml'
  }

  options {
    disableConcurrentBuilds()
    timestamps()
  }

  stages {

    stage('Checkout') {
      steps {
        checkout([
          $class: 'GitSCM',
          branches: [[name: '*/main']],
          userRemoteConfigs: [[
            url: 'https://github.com/subham601/intelligent-devops-platform.git',
            credentialsId: 'github-token'
          ]]
        ])

        sh '''
          git checkout -B main origin/main

          echo "====== 📦 Checkout Stage ======"
          echo "✅ Repository checked out successfully"
          echo "Current branch: $(git rev-parse --abbrev-ref HEAD)"
          echo "Latest commit: $(git log -1 --oneline)"
          echo ""
        '''
      }
    }

    stage('Automatic Version Increment') {
      steps {
        sh '''
          echo "====== 📝 Version Increment ======"
          ./scripts/update-image-tag.sh
          echo "✅ Version updated successfully"
          echo ""
        '''
      }
    }

    stage('Build Backend') {
      steps {
        sh '''
          echo "====== 🔨 Build Backend Stage ======"
          make build
          echo "✅ Backend build completed"
          echo ""
        '''
      }
    }

    stage('Run Tests') {
      steps {
        sh '''
          echo "====== ✔️  Test Stage ======"
          make test
          echo "✅ Tests completed"
          echo ""
        '''
      }
    }

    stage('SonarQube Scan') {
      environment {
        SONARQUBE_TOKEN = credentials("sonarqube-token")
      }
      steps {
        sh '''
          echo "====== 🔍 SonarQube Scan Stage ======"
        '''
        withSonarQubeEnv('sonarqube') {
          sh 'mvn -q -f backend/pom.xml sonar:sonar -DskipTests=true -Dsonar.login="$SONARQUBE_TOKEN"'
        }
        sh '''
          echo "✅ SonarQube scan completed"
          echo ""
        '''
      }
    }

    stage('Sonar Quality Gate') {
      environment {
        SONARQUBE_TOKEN = credentials("sonarqube-token")
      }
      steps {
        sh '''
          echo "====== 🎯 Sonar Quality Gate Stage ======"
        '''
        withSonarQubeEnv('sonarqube') {
          sh 'mvn -q -f backend/pom.xml sonar:sonar -DskipTests=true -Dsonar.login="$SONARQUBE_TOKEN" -Dsonar.qualitygate.wait=true'
        }
        sh '''
          echo "✅ Quality gate passed"
          echo ""
        '''
      }
    }

    stage('OWASP Dependency Check') {
      environment {
        NVD_API_KEY = credentials('nvd-api-key')
      }
      steps {
        sh '''
          echo "====== 🛡️  OWASP Dependency Check ======"
          echo "Running OWASP Dependency Check..."
          mkdir -p /tmp/nvd-cache
          mvn -f backend/pom.xml -DskipTests \
          -Ddependency-check.data.directory=/tmp/nvd-cache \
          -Dnvd.api.key=${NVD_API_KEY} \
          dependency-check:check || true
          echo "✅ OWASP check completed"
          echo ""
        '''
      }
    }

    stage('Trivy Scan') {
      steps {
        sh '''
          echo "====== 🔐 Trivy Security Scan ======"
          echo "Running Trivy Scan..."
          trivy --version || echo "⚠️  Trivy not installed"
          trivy fs --exit-code 0 --severity HIGH,CRITICAL --ignore-unfixed backend frontend || true
          echo "✅ Trivy scan completed"
          echo ""
        '''
      }
    }

    stage('Docker Build Backend') {
      steps {
        sh '''
          echo "====== 🐳 Docker Build Backend ======"
          ./scripts/build.sh backend
          echo "✅ Docker image built successfully"
          echo ""
        '''
      }
    }

    stage('Docker Build Frontend') {
      steps {
        sh '''
          echo "====== 🐳 Docker Build Frontend ======"
          ./scripts/build.sh frontend
          echo "✅ Docker image built successfully"
          echo ""
        '''
      }
    }

    stage('Docker Push Backend') {
      steps {
        withCredentials([usernamePassword(
          credentialsId: env.DOCKERHUB_CREDENTIALS_ID,
          usernameVariable: 'DOCKERHUB_USER',
          passwordVariable: 'DOCKERHUB_PASS'
        )]) {
          sh '''
            echo "====== 📤 Docker Push Backend ======"
            echo "$DOCKERHUB_PASS" | docker login -u "$DOCKERHUB_USER" --password-stdin docker.io
            ./scripts/deploy.sh push-backend
            echo "✅ Backend image pushed to Docker Hub"
            echo ""
          '''
        }
      }
    }

    stage('Docker Push Frontend') {
      steps {
        withCredentials([usernamePassword(
          credentialsId: env.DOCKERHUB_CREDENTIALS_ID,
          usernameVariable: 'DOCKERHUB_USER',
          passwordVariable: 'DOCKERHUB_PASS'
        )]) {
          sh '''
            echo "====== 📤 Docker Push Frontend ======"
            echo "$DOCKERHUB_PASS" | docker login -u "$DOCKERHUB_USER" --password-stdin docker.io
            ./scripts/deploy.sh push-frontend
            echo "✅ Frontend image pushed to Docker Hub"
            echo ""
          '''
        }
      }
    }

    stage('Update Helm values.yaml') {
      steps {
        sh '''
          echo "====== 📋 Helm Values Check ======"
          git diff --exit-code -- helm/intelligent-platform/values.yaml || true
          echo "✅ Helm values checked"
          echo ""
        '''
      }
    }

    stage('Git Commit') {
      steps {
        sh '''
          echo "====== 💾 Git Commit ======"
          git config user.email "jenkins@local"
          git config user.name "Jenkins"

          git add helm/intelligent-platform/values.yaml
          git commit -m "chore(ci): bump image tags" || echo "ℹ️  No changes to commit"
          echo "✅ Git commit completed"
          echo ""
        '''
      }
    }

    stage('Git Push') {
      steps {
        withCredentials([usernamePassword(
          credentialsId: 'github-token',
          usernameVariable: 'GIT_USER',
          passwordVariable: 'GIT_TOKEN'
        )]) {
          sh '''
            #!/bin/bash
            set -e

            echo "====== 🚀 Git Push Stage ======"

            git config user.email "jenkins@local"
            git config user.name "Jenkins"

            git checkout -B main

            echo "Current branch:"
            git branch

            if [ -z "$GIT_USER" ]; then
              echo "❌ GIT_USER missing"
              exit 1
            fi

            if [ -z "$GIT_TOKEN" ]; then
              echo "❌ GIT_TOKEN missing"
              exit 1
            fi

            echo "✅ GitHub credentials loaded"

            git remote set-url origin \
            https://${GIT_USER}:${GIT_TOKEN}@github.com/subham601/intelligent-devops-platform.git

            git fetch origin

            git pull --rebase origin main || true

            echo "Recent commits:"
            git log --oneline -5

            echo "Pushing commit..."
            git push origin HEAD:main

            echo "✅ Git Push Successful"
          '''
        }
      }
    }

    stage('Deployment Verification') {
      steps {
        sh '''
          echo "====== 🔍 Deployment Verification ======"
        '''
        withEnv(['KUBECONFIG=/root/.kube/config']) {
          sh '''
            echo "Checking rollout status..."
            kubectl rollout status deploy/intelligent-platform -n intelligent-platform --timeout=180s || true
            
            echo ""
            echo "Pod details:"
            kubectl get pods -n intelligent-platform -l app.kubernetes.io/name=intelligent-platform -o wide || true
            echo "✅ Deployment verification completed"
            echo ""
          '''
        }
      }
    }

    stage('Slack Notification') {
      when {
        expression { currentBuild.currentResult == 'SUCCESS' }
      }
      steps {
        script {
          def msg = "✅ Build #${env.BUILD_NUMBER} SUCCESS: intelligent-devops-platform"
          sh '''
            echo "====== 📢 Slack Notification ======"
            curl -X POST -H 'Content-type: application/json' \
            --data '{"text":"''' + msg + '''"}' \
            ${SLACK_WEBHOOK} || true
            echo "✅ Notification sent"
            echo ""
          '''
        }
      }
      environment {
        SLACK_WEBHOOK = credentials("slack-webhook")
      }
    }
  }

  post {
    failure {
      script {
        def msg = "❌ Build #${env.BUILD_NUMBER} FAILED: intelligent-devops-platform"
        sh '''
          echo "====== 📢 Slack Failure Notification ======"
          curl -X POST -H 'Content-type: application/json' \
          --data '{"text":"''' + msg + '''"}' \
          ${SLACK_WEBHOOK} || true
          echo "❌ Failure notification sent"
        '''
      }
    }
    always {
  sh '''#!/bin/bash
set +e
BUILD_STATUS="${BUILD_RESULT}"
TIMESTAMP=$(date '+%Y-%m-%d %H:%M:%S')
echo "Timestamp: ${TIMESTAMP}"
  '''
}
