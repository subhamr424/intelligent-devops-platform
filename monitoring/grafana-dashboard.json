      "options": {"legend": {"showLegend": true}},
      "targets": [
        {
          "expr": "rate(http_server_requests_seconds_count{namespace=\"intelligent-platform\",uri=~\"/actuator.*\"}[5m])",
          "legendFormat": "actuator"
        }
      ],
      "title": "Backend actuator request rate",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "options": {"legend": {"showLegend": true}},
      "targets": [
        {
          "expr": "rate(jvm_memory_used_bytes{namespace=\"intelligent-platform\"}[5m])",
          "legendFormat": "jvm memory"
        }
      ],
      "title": "JVM memory used (bytes rate proxy)",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "id": 3,
      "options": {"legend": {"showLegend": true}},
      "targets": [
        {
          "expr": "sum(rate(process_cpu_usage{namespace=\"intelligent-platform\"}[5m])) by (pod)",
          "legendFormat": "cpu"
        }
      ],
      "title": "CPU usage per pod",
      "type": "timeseries"
    }
  ],
